<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ Backup / Device Transfer 规则。

   授权数据绝不能被云备份或设备迁移带走 — 否则 license_prefs.xml 会被恢复覆盖。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="license_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="license_prefs.xml" />
    </device-transfer>
</data-extraction-rules>